# Copy to .env and fill in for a REAL run.
# Leave everything unset (or DEMO_MODE=mock) to run the full pipeline
# for free, offline, with deterministic mock responses.

DEMO_MODE=mock            # "mock" (no keys, no cost) or "live" (real Claude + E2B calls)

# Only required when DEMO_MODE=live
ANTHROPIC_API_KEY=
E2B_API_KEY=

# Fixed per the job spec — do not change for benchmark submissions
CLAUDE_MODEL=claude-opus-4-8
